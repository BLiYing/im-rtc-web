{
  "name": "im-rtc-web",
  "private": true,
  "version": "0.0.0",
  "description": "im-rtc Web 客户端 SDK：call-engine（无 UI）+ call-uikit-react + Demo",
  "workspaces": [
    "packages/*",
    "demo",
    "demo-react"
  ],
  "scripts": {
